# LLM 服务配置（OpenAI 兼容 Chat Completions 协议，可随时换厂商/模型）
# 示例（以各官方文档为准）：
#   GLM:     LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   模型名以账号可用列表为准
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com              模型名以账号可用列表为准
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 可选：轻量操作（改造/追问）使用的快速模型，未配置时回落 LLM_MODEL
LLM_MODEL_FAST=

# 可选：思考强度 low|medium|high（OpenAI 兼容 reasoning_effort，GLM 支持）
# 生成偏慢时设 low 可显著降低延迟；不配置则使用服务默认值
LLM_REASONING_EFFORT=

# 可选：博查（Bocha）Web Search API Key，开放平台 https://open.bochaai.com
# 配置后生成讲解前会自动检索网络资料补充事实依据；留空则跳过检索，不影响生成
BOCHA_API_KEY=
