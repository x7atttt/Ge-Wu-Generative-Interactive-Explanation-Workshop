# LLM 服务配置（OpenAI 兼容 Chat Completions 协议，可随时换厂商/模型）
# 示例（以各官方文档为准）：
#   GLM:     LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   模型名以账号可用列表为准
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com              模型名以账号可用列表为准
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 可选：轻量操作（改造/追问）使用的快速模型，未配置时回落 LLM_MODEL
LLM_MODEL_FAST=
